export default async function handler(req, res) {
  if (req.method !== "POST") {
    return res.status(200).send("NFT Gifts Academy bot is running");
  }

  const token = process.env.BOT_TOKEN;

  if (!token) {
    return res.status(500).json({ ok: false, error: "BOT_TOKEN is missing" });
  }

  const message = req.body?.message;

  if (message?.text === "/start") {
    await fetch(`https://api.telegram.org/bot${token}/sendMessage`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        chat_id: message.chat.id,
        text: "Привет, дружище! 👋 Добро пожаловать в NFT Gifts Academy! Нажми кнопку ниже, чтобы связаться с нашим менеджером.",
        reply_markup: {
          inline_keyboard: [[
            { text: "Связаться с менеджером", url: "https://t.me/menegerovi" }
          ]]
        }
      })
    });
  }

  return res.status(200).json({ ok: true });
}
